  m_text: '<size=52><color=#9E98A6><b>S // N U L L</b></color></size>



    <size=18><color=#64777D>[
    PERSONNEL ARCHIVE // SECTOR NULL ]</color></size>

    <size=18><color=#64777D>____________________________________________</color></size>



    <size=24><color=#7F9298>DEVELOPED
    BY</color></size>

    <size=32><color=#E6EEF0>Rocky Labs</color></size>



    <size=24><color=#7F9298>ASSETS
    USED</color></size>

    <size=26><color=#C8D4D7>UHFPS</color></size>

    <size=26><color=#C8D4D7>Abandoned
    Asylum</color></size>

    <size=26><color=#C8D4D7>Sci-Fi Warehouse Kit</color></size>



    <size=24><color=#7F9298>SPECIAL
    THANKS</color></size>

    <size=24><color=#C8D4D7>Our instructor, teammates,</color></size>

    <size=24><color=#C8D4D7>and
    playtesters.</color></size>



    <size=18><color=#64777D>____________________________________________</color></size>



    <size=24><color=#E6EEF0>Thank
    you for entering Sector Null.</color></size>'
