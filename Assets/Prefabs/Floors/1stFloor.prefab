    m_TransformParent: {fileID: 1707055106498211436}
    m_Modifications:
    - target: {fileID: 676244225140074482, guid: 2290421a90386fe40b7a4497c38b7323, type: 3}
      propertyPath: noteContent
      value: "TO ANYONE WHO FINDS THIS,\r\nThe theater room was sealed after the
        last containment failure, and no one below senior clearance was told what
        was inside. Power to the lock was split across three emergency fuses, supposedly
        to keep the section isolated, though that was never the full story.\r\nSomething
        in that room was important enough to bury, and the people in charge made
        sure it stayed buried. If you are trying to open it now, then you are already
        deeper into the facility than you should be.\r\n\u2014 Restricted Notice\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3173352636163525320, guid: 2290421a90386fe40b7a4497c38b7323, type: 3}
