    m_Modifications:
    - target: {fileID: 676244225140074482, guid: 2290421a90386fe40b7a4497c38b7323, type: 3}
      propertyPath: noteContent
      value: "TO ANYONE WHO FINDS THIS,\n\r\nI know what they hid in the theater
        room, but every route to it was sealed behind layered mechanisms. One part
        is hidden behind the device on this floor, and the rest was scattered where
        nobody would think to search. That was deliberate.\r\nIf you are still trying
        to force your way through, stop wasting time looking blindly. The answer
        is inside the room itself.\n\r\n\u2014 Hidden Notice\r\n"
      objectReference: {fileID: 0}
