    - target: {fileID: 676244225140074482, guid: 2290421a90386fe40b7a4497c38b7323, type: 3}
      propertyPath: noteContent
      value: "TO ANYONE WHO FINDS THIS,\n\r\nI locked this room myself, hoping no
        one would ever need what was stored inside. If you find a way in continuing
        what I could not finish. To open this door, you will need a lockpick.\r\nI
        am sorry it came to this, but once the facility started failing, hiding things
        became easier than explaining them.\n\n\r\n\u2014 Private Notice\r\n"
      objectReference: {fileID: 0}
